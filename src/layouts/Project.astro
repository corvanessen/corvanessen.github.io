---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const { title, summary, image, live, code, tech = [] } = frontmatter;
---
<Base title={title} description={summary} image={image}>
  <article class="project">
    <p class="back"><a href="/#projecten">← Alle projecten</a></p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <p class="links">
      {live && <a class="button" href={live}>Bekijk het live</a>}
      {code && <a class="button secondary" href={code}>Code op GitHub</a>}
    </p>
    {image && <img class="hero" src={image} alt={`Schermafbeelding van ${title}`} />}
    <div class="prose">
      <slot />
    </div>
    {tech.length > 0 && (
      <p class="tech">{tech.map((t: string) => <span>{t}</span>)}</p>
    )}
  </article>
</Base>
